# ===========================
# Pasig Clone — Backend Environment
# ===========================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Server ────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database (same instance as P2_OFFICIAL — separate schema: pasig_clone)
# Option 1: Full connection string (takes precedence over discrete vars)
DATABASE_URL=postgresql://user:password@localhost:5432/tb_system?sslmode=require

# Option 2: Discrete variables (fallback when DATABASE_URL is not set)
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=tb_system
# DB_PASSWORD=changeme
# DB_PORT=5432

# ── Auth (required) ──────────────────────────────────────
# Generate a strong random string (32+ chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme-generate-a-random-string
JWT_EXPIRES_IN=7d

# ── Webhook (P2_OFFICIAL integration) ────────────────────
TBINSIGHT_WEBHOOK_URL=http://localhost:5000/api/webhook/pasig-clone
WEBHOOK_SECRET=your-hmac-secret-change-this

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
