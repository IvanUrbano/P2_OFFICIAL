# PostgreSQL Database
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Server
PORT=5001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5174

# JWT (must match TBInsight's JWT_SECRET for shared auth)
JWT_SECRET=replace_with_strong_random_string
JWT_EXPIRES_IN=7d

# Webhook (must match TBInsight's WEBHOOK_SECRET)
WEBHOOK_SECRET=replace_with_strong_random_string

# TBInsight Webhook URL
TBINSIGHT_WEBHOOK_URL=http://localhost:3000/api/webhook/receive
