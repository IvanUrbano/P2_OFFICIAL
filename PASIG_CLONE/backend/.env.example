# PostgreSQL Database (PASIG_CLONE's own data: cases, import batches)
DATABASE_URL=postgresql://user:password@host:port/pasig_clone_db?sslmode=require

# Shared auth database — TBInsight's database (holds the shared users table).
# Use the same value as DATABASE_URL in BACKEND/.env
AUTH_DATABASE_URL=postgresql://user:password@host:port/neondb?sslmode=require

# Server
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5174

# JWT (must match TBInsight's JWT_SECRET for shared auth)
JWT_SECRET=replace_with_strong_random_string
JWT_EXPIRES_IN=7d

# Webhook (must match TBInsight's WEBHOOK_SECRET)
WEBHOOK_SECRET=replace_with_strong_random_string

# TBInsight Webhook URL
TBINSIGHT_WEBHOOK_URL=http://localhost:5000/api/webhook/pasig-clone
