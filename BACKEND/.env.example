# PostgreSQL Database
# Local: use discrete vars below
# Production (Render): use DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

DB_USER=postgres
DB_HOST=localhost
DB_NAME=tb_system
DB_PASSWORD=your_password_here
DB_PORT=5432

# Server
PORT=3000

# JWT (generate your own for production)
JWT_SECRET=replace_with_strong_random_string
JWT_EXPIRES_IN=7d

# Rate Limiting
LOGIN_LIMIT_WINDOW_MINS=15
LOGIN_LIMIT_MAX=5

# Webhook (must match PASIG_CLONE's WEBHOOK_SECRET)
WEBHOOK_SECRET=replace_with_strong_random_string
