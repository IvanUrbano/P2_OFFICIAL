# ===========================
# TB System — Backend Environment
# ===========================
# Copy this file to .env and fill in your values.
#   cp BACKEND/.env.example BACKEND/.env

# ── Database ──────────────────────────────────────────────
# Option 1: Discrete variables (used when DATABASE_URL is not set)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=tb_system
DB_PASSWORD=changeme
DB_PORT=5432

# Option 2: Full connection string (takes precedence over discrete vars)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Auth (required) ──────────────────────────────────────
# Generate a strong random string (32+ chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme-generate-a-random-string
JWT_EXPIRES_IN=7d

# ── Rate Limiting ────────────────────────────────────────
LOGIN_LIMIT_WINDOW_MINS=15
LOGIN_LIMIT_MAX=5

# ── CORS (optional) ──────────────────────────────────────
# Add your frontend URL if running on a different origin
# FRONTEND_URL=http://localhost:5173

# ── ML Service ───────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001

# ── Webhook (Pasig Clone integration) ─────────────────────
# Must match PASIG_CLONE's WEBHOOK_SECRET for HMAC verification
WEBHOOK_SECRET=changeme-use-same-value-in-pasig-clone
