# Database connection string (PostgreSQL via Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT secret for token signing (use a strong random string)
JWT_SECRET=your-secret-here

# JWT expiration (default: 7d)
JWT_EXPIRES_IN=7d

# Login rate limiting
LOGIN_LIMIT_WINDOW_MINS=15
LOGIN_LIMIT_MAX=5

# API rate limiting
API_LIMIT_MAX=300

# Webhook shared secret (must match Pasig Clone's WEBHOOK_SECRET)
WEBHOOK_SECRET=your-webhook-secret-here

# ML Service API key (must match ML_SERVICE's ML_API_KEY)
ML_API_KEY=your-ml-api-key-here

# ML Service URL (production: https://tb-system-ml.onrender.com)
ML_SERVICE_URL=http://localhost:8001

# Frontend URL for CORS (production: https://p2-official.vercel.app)
FRONTEND_URL=http://localhost:5173

# Server port (default: 3000)
PORT=3000

# Environment (development | production)
NODE_ENV=development
