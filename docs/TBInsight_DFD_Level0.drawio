<mxfile host="app.diagrams.net"><diagram id="dfd-l0" name="DFD Level 0"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="730" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pasig" value="&lt;b&gt;Source System&lt;/b&gt;&lt;br&gt;(PASIG TB-IS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="200" height="100" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Health Officers /&lt;br&gt;Administrators&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;(Health Facility Focal Persons &amp;amp;&lt;br&gt;NTP TB-DOTS Coordinators)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1210" y="40" width="230" height="590" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b style=&quot;font-size:16px&quot;&gt;Process 0&lt;/b&gt;&lt;br&gt;&lt;b&gt;TBInsight: A GIS-Based Predictive&lt;br&gt;Tuberculosis Surveillance and&lt;br&gt;Decision-Support System for Pasig City&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;perimeter=ellipsePerimeter;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="480" height="630" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Notes:&lt;/b&gt; Dashed arrow = data into the system; solid arrow = data out of the system. Health Officers / Administrators covers both user roles: Focal Persons (Staff) see their own barangay / facility and Coordinators (Admin) see the whole city. Flows marked (Admin) are available to Coordinators only. TB cases are encoded and validated in PASIG TB-IS and arrive through the sync." style="text;html=1;whi