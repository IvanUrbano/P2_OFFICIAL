<mxfile host="app.diagrams.net"><diagram id="dfd-l0" name="DFD Level 0"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="890" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;TB System — Data Flow Diagram (Level 0 / Context Diagram)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;PASIG Clone (TB case data collection) + TBInsight (GIS hotspot &amp;amp; resource-prioritization system)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="56" as="geometry"/></mxCell><mxCell id="staff" value="Health Facility Focal Person&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;(Staff)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="600" as="geometry"/></mxCell><mxCell id="admin" value="NTP TB-DOTS Coordinator&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;(Admin)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1430" y="110" width="230" height="600" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b&gt;0&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;&lt;b&gt;TB Hotspot &amp;amp; Resource-&lt;br&gt;Prioritization System&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;(PASIG Clone + TBInsight)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;perimeter=ellipsePerimeter;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="