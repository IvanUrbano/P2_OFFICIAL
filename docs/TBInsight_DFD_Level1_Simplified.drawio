<mxfile host="app.diagrams.net"><diagram id="dfd-l1-simple" name="DFD Level 1 (Simplified)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2530" pageHeight="1230" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;TBInsight — Data Flow Diagram (Level 1, Simplified)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;From PASIG Clone data collection and cleaning, through the databases and prediction pipeline, to TBInsight&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="900" height="56" as="geometry"/></mxCell><mxCell id="laneA" value="&lt;b&gt;PASIG CLONE&lt;/b&gt; — data collection, cleaning &amp;amp; validation&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;(PASIG Clone database: D1–D4)&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=14;fillColor=#F4F9F1;strokeColor=#82B366;strokeWidth=1.5;align=right;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="2230" height="400" as="geometry"/></mxCell><mxCell id="laneB" value="&lt;b&gt;TBINSIGHT&lt;/b&gt; — storage, prediction pipeline &amp;amp; dashboard&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;(TBInsight database: D5–D8)&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=14;fillColor=#F3F7FC;strokeColor=#6C8EBF;strokeWidth=1.5;align=right;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="20" y="585" width="2230" height="545" as="geometry"/></mxCell><mxCell id="pipe" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=14;fillColor=none;strokeColor=#9673A6;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="655" y="780" width="1235" height="165" as="geometry"/></mxCell><mxCell id="pipeLbl" value="&lt;b&gt;Automated prediction pipeline&lt;/b&gt;&lt;br&gt;(runs after every sync)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#6A4C93;" vertex="1" parent="1"><mxGeometry x="1508" y="904" width="190" height="36" as="geometry"/></mxCell><mxCell id="staff" value="PASIG Health Facility Staff / Admin&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;(TB-DOTS encoders)&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="300" y="78" width="1250" height="62" as="geometry"/></mxCell><mxCell id="officer" value="Health Officers /&lt;br&gt;Administrators&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;(TBInsight users)&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="2340" y="825" width="170" height="90" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;1.0&lt;/b&gt;&lt;br&gt;Import Case Files&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(Excel / CSV upload)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;perimeter=ellipsePerimeter;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="180" height="100" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;2.0&lt;/b&gt;&lt;br&gt;Clean Data&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(standardize names,&lt;br&gt;dates &amp;amp; values)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;perimeter=ellipsePerimeter;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex=